{
  "name": "omnintent",
  "version": "0.1.0",
  "description": "Describe your app's actions once in omnintent.json; generate Siri App Intents, Android AppFunctions and a remote MCP server.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "omnintent": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "node scripts/copy-schema.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
